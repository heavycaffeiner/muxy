+            const previous = current.prev.?;
+            const previous_page = previous.page();
+            const previous_row = &previous_page.rows.ptr(previous_page.memory.ptr)[previous.rows() - 1];
+            current = screen.clonePartialRowGrowCapacity(current, start, previous_page, previous_row, 0, self.cols);
+            current.page().dirty = true;
+            current = previous;
+        }
+        screen.cursorReload();
+        try screen.cursorScrollAbove();
+        return true;
+    }
