+        region.right != self.cols - 1 or screen.no_scrollback or
+        screen.cursor.y != region.bottom) return false;
+    const first = screen.pages.pin(.{ .active = .{} }) orelse return false;
+    const last = screen.pages.pin(.{ .active = .{ .y = region.top } }) orelse return false;
