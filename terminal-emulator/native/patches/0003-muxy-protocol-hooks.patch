 /// C: GhosttyTerminal
 pub const Terminal = ?*TerminalWrapper;
 
+pub fn muxy_events(value: Terminal, callback: ?@import("../muxy_compat.zig").Callback, userdata: ?*anyopaque) callconv(lib.calling_conv) void {
+    const wrapper = value orelse return;
+    wrapper.stream.handler.muxy.callback = callback;
+    wrapper.stream.handler.muxy.userdata = userdata;
+}
+
+pub fn muxy_cell(value: Terminal, x: u16, y: u16, cp: u32, encoded: u64) callconv(lib.calling_conv) Result {
+    const wrapper = value orelse return .invalid_value;
+    const t = wrapper.terminal;
+    if (x >= t.cols or y >= t.rows or cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff)) return .invalid_value;
+    const compat = @import("../muxy_compat.zig");
+    var buffer: [64]u8 = undefined;
+    const image = encoded & 0x8000 != 0;
+    const uri = if (image) std.fmt.bufPrint(&buffer, "muxy-cell-image:{x:0>16}", .{encoded}) catch return .out_of_memory else null;
+    const scalar: u21 = @intCast(cp);
+    compat.cell(t, x, y, &.{scalar}, if (image) .{} else compat.decodedStyle(encoded), encoded & 128 != 0, uri) catch return .out_of_memory;
+    return .success;
+}
+
+pub fn muxy_advance(value: Terminal, count: u16, x: u16) callconv(lib.calling_conv) Result {
+    const wrapper = value orelse return .invalid_value;
+    if (x >= wrapper.terminal.cols) return .invalid_value;
+    for (0..count) |_| wrapper.terminal.index() catch return .out_of_memory;
+    wrapper.terminal.screens.active.cursorHorizontalAbsolute(x);
+    wrapper.terminal.screens.active.cursor.pending_wrap = false;
+    return .success;
+}
+
+/// Drop program color overrides (OSC 4, 10, 11, 12) so the defaults apply.
+pub fn muxy_reset_colors(value: Terminal) callconv(lib.calling_conv) void {
+    const wrapper = value orelse return;
+    const t = wrapper.terminal;
+    t.colors.palette.resetAll();
+    t.colors.foreground.reset();
+    t.colors.background.reset();
+    t.colors.cursor.reset();
+    t.flags.dirty.palette = true;
+}
+
+/// Kitty keyboard flags in the low byte, modifyOtherKeys level 2 in bit 8.
+pub fn muxy_keyboard(value: Terminal) callconv(lib.calling_conv) u32 {
+    const wrapper = value orelse return 0;
+    const t = wrapper.terminal;
+    const flags: u32 = t.screens.active.kitty_keyboard.current().int();
+    return flags | (@as(u32, @intFromBool(t.flags.modify_other_keys_2)) << 8);
+}
+
+/// Return and clear the processing failure flag, so one failed sequence
+/// does not mark every later write as failed.
+pub fn muxy_take_failure(value: Terminal) callconv(lib.calling_conv) bool {
+    const wrapper = value orelse return false;
+    var failed = wrapper.stream.handler.semantic_failure;
+    wrapper.stream.handler.semantic_failure = false;
+    var screens = wrapper.terminal.screens.all.iterator();
+    while (screens.next()) |entry| {
+        failed = failed or entry.value.*.blank_style_failed;
+        entry.value.*.blank_style_failed = false;
+    }
+    return failed;
+}
+
+pub fn muxy_cursor(value: Terminal, x: u16, y: u16) callconv(lib.calling_conv) Result {
+    const wrapper = value orelse return .invalid_value;
+    if (x >= wrapper.terminal.cols or y >= wrapper.terminal.rows) return .invalid_value;
+    wrapper.terminal.screens.active.cursorAbsolute(x, y);
+    wrapper.terminal.screens.active.cursor.pending_wrap = false;
+    return .success;
+}
+
+pub fn muxy_scroll(value: Terminal) callconv(lib.calling_conv) Result {
+    const wrapper = value orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const region = t.scrolling_region;
+    defer t.scrolling_region = region;
+    t.scrolling_region = .{ .top = 0, .bottom = t.rows - 1, .left = 0, .right = t.cols - 1 };
+    t.scrollUp(1) catch return .out_of_memory;
+    return .success;
+}
+
